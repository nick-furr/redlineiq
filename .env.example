# RedlineIQ Backend Configuration

# Anthropic API Key (required)
ANTHROPIC_API_KEY=

# Server
PORT=

# Model configuration. For Claude 4.6+ generation, the dateless form IS the
# pinned snapshot per Anthropic docs — no separate dated suffix exists. For
# 4.5 and earlier (e.g. claude-sonnet-4-20250514), use the dated form
# explicitly. See docs/decisions/0003-pin-model-versions.md.
CLAUDE_MODEL=claude-sonnet-4-6

# Note: temperature is pinned to 0 in code (src/services/extraction-service.js
# + evals/lib/llm-judge.js) per ADR 0003 for deterministic eval; not an env
# var. Don't change without re-baselining.

# Upload limits
MAX_FILE_SIZE_MB=
MAX_PAGES=

# Output directory for processed extractions
OUTPUT_DIR=

# LangFuse observability (get keys from cloud.langfuse.com → your project → Settings)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Only needed if self-hosting; omit for cloud
# LANGFUSE_BASE_URL=

# Sentry error tracking (get DSN from sentry.io → your project → Settings → Client Keys)
SENTRY_DSN=
# Reduce in production to avoid high transaction volume (e.g. 0.1 =
SENTRY_TRACES_SAMPLE_RATE=
