# Claude Code — the agent team (.claude/agents/) and skills (.claude/skills/)
# are checked in; only machine-local settings stay out
.claude/settings.local.json

# Eval — source plan PDFs are large, not committed
evals/synthetic/source/
# Generated sheet outputs (regenerate with generate.py)
evals/synthetic/*/output.pdf
evals/synthetic/*/output.png

# Collaborator-proprietary cases — real plans shared by third parties that may carry
# confidentiality expectations. Convention: case_C* for working-set, case_hC* for holdout.
# Local-only, never push. See evals/CONVENTIONS.md for the full naming + metadata scheme.
evals/pdfs/case_C*.pdf
evals/labels/case_C*.json
evals/holdout/case_hC*.pdf
evals/labels/case_hC*.json

# Real third-party plans downloaded online (Bohler grading, San Marcos framing) with
# my own markups added. Publicly downloadable but still someone else's drawings — not
# redistributed via this repo. Local-only.
evals/pdfs/case_011_*.pdf
evals/pdfs/case_012_*.pdf

# Tooling caches and local-only scratch
.playwright-mcp/
.tmp.driveupload/
evals/synthetic/previews/midlands_tech_toilet_reno/
evals/synthetic/previews/unlv_structural/

# Dogfood source PDFs — may contain client/proprietary content from real reviews
